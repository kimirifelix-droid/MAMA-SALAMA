# Copy this file to .env and fill in your own values.
# Get AT_USERNAME / AT_API_KEY for free at https://africastalking.com (sandbox app).

AT_USERNAME=sandbox
AT_API_KEY=

# Optional: a registered sender ID / shortcode once you have one approved
AT_SENDER_ID=

# Where SOS alerts get texted — use a real number your team actually monitors
MIDWIFE_ALERT_NUMBER=+254700000000

PORT=3000
